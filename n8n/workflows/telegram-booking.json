        "id": "webhook-telegram-1",
        "name": "📱 Webhook Telegram",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [240, 300],
        "webhookId": "auto-generated"
      },
      {
        "parameters": {
          "values": {
            "string": [
              {
                "name": "chatId",
                "value": "={{ $json.body.message.chat.id }}"
              },
              {
                "name": "message",
                "value": "={{ $json.body.message.text }}"
              },
              {
                "name": "userId",
                "value": "={{ $json.body.message.from.id }}"
              },
              {
                "name": "userName",
                "value": "={{ $json.body.message.from.first_name }} {{ $json.body.message.from.last_name }}"
              },
              {
                "name": "timestamp",
                "value": "={{ $json.body.message.date }}"
              }
            ]
          },
          "options": {}
        },
        "id": "set-telegram-1",
        "name": "📝 Extract Message Data",
        "type": "n8n-nodes-base.set",
        "typeVersion": 1,
        "position": [460, 300]
      },
      {
        "parameters": {
          "url": "={{ $env.NEXTJS_APP_URL }}/api/ai/chat",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "newMessage",
                "value": "={{ $json.message }}"
              },
              {
                "name": "telegramId",
                "value": "={{ $json.chatId }}"
              },
              {
                "name": "channel",
                "value": "telegram"
              },
              {
                "name": "userName",
                "value": "={{ $json.userName }}"
              }
            ]
          },
          "options": {
            "timeout": 30000
          }
        },
        "id": "http-telegram-1",
        "name": "🤖 Call AI API",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [680, 300]
      },
      {
        "parameters": {
          "conditions": {
            "options": [
              {
                "name": "Success",
                "conditions": {
                  "and": [
                    {
                      "leftValue": "={{ $json.message }}",
                      "rightValue": "",
                      "operation": "isNotEmpty"
                    }
                  ]
                }
              },
              {
                "name": "Error",
                "conditions": {
                  "and": [
                    {
                      "leftValue": "={{ $json.error }}",
                      "rightValue": "",
                      "operation": "isNotEmpty"
                    }
                  ]
                }
              }
            ]
          }
        },
        "id": "if-telegram-1",
        "name": "✅ Check Response",
        "type": "n8n-nodes-base.if",
        "typeVersion": 1,
        "position": [900, 300]
      },
      {
        "parameters": {
          "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "chat_id",
                "value": "={{ $('Extract Message Data').item.json.chatId }}"
              },
              {
                "name": "text",
                "value": "={{ $json.message }}"
              },
              {
                "name": "parse_mode",
                "value": "Markdown"
              }
            ]
          }
        },
        "id": "http-telegram-2",
