              "action": "TELEGRAM_MESSAGE_RECEIVED",
              "entity": "ConversationHistory",
              "entityId": "={{ $('Call AI API').item.json.conversationId }}",
              "source": "telegram",
              "changes": "={{ JSON.stringify({ chatId: $('Extract Message Data').item.json.chatId, message: $('Extract Message Data').item.json.message }) }}"
            }
          }
        },
