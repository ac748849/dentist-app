              "type": "main",
              "index": 0
            }
          ],
          [
            {
              "node": "⚠️ Send Error Message",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "💬 Send WhatsApp Reply": {
        "main": [
          [
            {
              "node": "📊 Log to Database",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "📊 Log to Database": {
        "main": [
          [
            {
              "node": "🔍 Check Tool Calls",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "🔍 Check Tool Calls": {
        "main": [
          [
            {
              "node": "📅 Create Google Calendar Event",
              "type": "main",
              "index": 0
            },
            {
              "node": "🔔 Notify Dentist",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
