// prisma/schema.prisma - Version 3.0 (IA Conversationnelle)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// EXISTANT (Sessions précédentes)
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  DENTIST
  PATIENT
}

model Patient {
  id              String    @id @default(cuid())
  phone           String    @unique
  name            String
  email           String?
  dateOfBirth     DateTime?
  ageCategory     PatientAge @default(ADULTE)
  
  // Multi-canal
  whatsappPhone   String?
  telegramId      String?   @unique
  preferredChannel String?
  
  // Médical
  medicalHistory  Json?
  notes           String?
  
  // Relations
  appointments    Appointment[]
  conversations   ConversationHistory[]
  preferences     PatientPreferences?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PatientAge {
  ENFANT
  ADOLESCENT
  ADULTE
  SENIOR
}

model Dentist {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  specialties   String[]
  workingHours  Json?
  
  // Google Calendar
  googleCalendarId       String?   @unique
  googleAccessToken      String?
  googleRefreshToken     String?
  googleTokenExpiry      DateTime?
  googleCalendarEnabled  Boolean   @default(false)
  googleWebhookChannelId String?
  googleWebhookExpiry    DateTime?
  
  // Relations
  appointments  Appointment[]
  knowledgeBase KnowledgeBase[]
  customRules   CustomRule[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Appointment {
  id                    String           @id @default(cuid())
  dentistId             String
  patientId             String
  
  startTime             DateTime
  endTime               DateTime
  status                AppointmentStatus @default(PENDING)
  source                String            @default("web")
  
  // Type d'intervention
  interventionType      InterventionType  @default(CONTROLE)
  duration              Int               // En minutes
  
  // Google Calendar
  googleCalendarEventId String?           @unique
  googleCalendarLink    String?
  syncedWithGoogle      Boolean           @default(false)
  lastSyncedAt          DateTime?
  
  // N8N
  n8nExecutionId        String?
  automationLogs        Json?
  
  // Notes
  notes                 String?           // Patient
  dentistNotes          String?           // Privé dentiste
  
  // Relations
  dentist               Dentist           @relation(fields: [dentistId], references: [id])
  patient               Patient           @relation(fields: [patientId], references: [id])
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  @@index([dentistId, startTime])
  @@index([patientId])
  @@index([status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum InterventionType {
  // Consultations
  CONTROLE
  URGENCE
  PREMIERE_VISITE
  
  // Soins
  CARIE
  DEVITALISATION
  EXTRACTION
  DETARTRAGE
  BLANCHIMENT
  
  // Prothèses
  COURONNE
  BRIDGE
  IMPLANT
  PROTHESE_COMPLETE
  PROTHESE_PARTIELLE
  
  // Orthodontie
  ORTHODONTIE_CONSULTATION
  ORTHODONTIE_SUIVI
  ORTHODONTIE_POSE
  ORTHODONTIE_RETRAIT
  
  // Pédiatrie
  PEDIATRIE_CONTROLE
  PEDIATRIE_SOIN
  PEDIATRIE_PREVENTION
  
  // Chirurgie
  CHIRURGIE_SIMPLE
  CHIRURGIE_COMPLEXE
  GREFFE_OSSEUSE
  
  // Autre
  AUTRE
}

model InterventionDuration {
  id                  String           @id @default(cuid())
  interventionType    InterventionType @unique
  defaultDuration     Int              // Minutes
  minDuration         Int
  maxDuration         Int
  estimatedPrice      Float?
  requiresPreparation Boolean          @default(false)
  preparationNotes    String?
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// ============================================================
// 🆕 NOUVEAUX MODÈLES (IA Conversationnelle)
// ============================================================

// 1. Base de connaissances éditable par le dentiste
model KnowledgeBase {
  id          String   @id @default(cuid())
  dentistId   String
  
  category    KBCategory
  title       String
  content     String   @db.Text
  
  // SEO & Search
  keywords    String[] // Pour recherche sémantique
  isActive    Boolean  @default(true)
  viewCount   Int      @default(0)
  
  // Métadonnées
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  dentist     Dentist  @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  
  @@index([dentistId, category])
  @@index([isActive])
}

enum KBCategory {
  TARIFS
  ACCES
  FAQ
  HORAIRES
  URGENCES
  SERVICES
  EQUIPE
  AUTRE
}

// 2. Règles personnalisées du dentiste (pour IA)
model CustomRule {
  id          String   @id @default(cuid())
  dentistId   String
  
  ruleType    RuleType
  priority    Int      @default(0) // Plus élevé = plus prioritaire
  
  // Configuration temporelle
  dayOfWeek   String?  // "monday", "tuesday", ..., "sunday", ou null = tous les jours
  timeStart   String?  // "10:00" format HH:mm
  timeEnd     String?  // "12:00" format HH:mm
  
  // Dates spécifiques (vacances, congés)
  specificDate DateTime?
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  
  // Description human-readable
  description String
  
  // Action
  action      RuleAction @default(BLOCK)
  
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  dentist     Dentist    @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  
  @@index([dentistId, isActive])
  @@index([priority])
}

enum RuleType {
  HORAIRE     // Bloquer certaines heures
  JOUR        // Bloquer certains jours
  PAUSE       // Pause déjeuner/pause
  BLOCAGE     // Blocage temporaire (vacances, formation)
  PREFERENCE  // Préférence (ex: préférer matin pour implants)
}

enum RuleAction {
  BLOCK       // Bloquer complètement
  DISCOURAGE  // Déconseiller mais autoriser
  PREFER      // Préférer ce créneau
}

// 3. Historique conversations (contexte IA)
model ConversationHistory {
  id             String   @id @default(cuid())
  patientId      String?
  
  // Identification canal
  channel        ConversationChannel
  externalId     String?  // WhatsApp phone, Telegram chat_id, session_id web
  
  // Messages
  messages       Json     // Array: [{role: "user"|"assistant", content: "...", timestamp}]
  
  // État conversation
  currentIntent  String?  // "booking", "info", "question", "cancel"
  currentStep    String?  // "collect_type", "collect_preferences", "propose_slots", etc.
  
  // Données extraites
  extractedData  Json?    // {intervention_type, preferred_days, preferred_time, urgency, etc.}
  
  // Métriques
  messageCount   Int      @default(0)
  isCompleted    Boolean  @default(false)
  satisfactionScore Int?  // 1-5
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?
  
  // Relations
  patient        Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  
  @@index([externalId, channel])
  @@index([patientId])
  @@index([isCompleted])
}

enum ConversationChannel {
  WEB
  WHATSAPP
  TELEGRAM
}

// 4. Préférences patient (pour ML & personnalisation)
model PatientPreferences {
  id                String   @id @default(cuid())
  patientId         String   @unique
  
  // Préférences explicites
  preferredDays     String[] // ["monday", "tuesday", "friday"]
  preferredTimes    String   @default("anytime") // "morning", "afternoon", "evening", "anytime"
  urgencyDefault    String   @default("normal")  // "urgent", "normal", "flexible"
  
  // Contraintes
  avoidDays         String[] // Jours à éviter
  minNoticeHours    Int?     // Délai minimum de réservation (ex: 24h)
  
  // Historique comportemental (pour ML)
  bookingHistory    Json?    // {total: 10, cancelled: 1, patterns: {...}}
  lastBookingDate   DateTime?
  averageRescheduleDays Int?
  
  // Communication
  preferredLanguage String   @default("fr")
  smsReminders      Boolean  @default(true)
  whatsappReminders Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// 5. Logs IA (debugging & analytics)
model AILog {
  id             String   @id @default(cuid())
  
  conversationId String?
  patientId      String?
  
  // Request
  prompt         String   @db.Text
  tools          Json?
  
  // Response
  response       String   @db.Text
  toolCalls      Json?    // Tools appelés par l'IA
  
  // Métriques
  provider       String   // "claude", "local", "ollama"
  model          String
  tokensInput    Int?
  tokensOutput   Int?
  latencyMs      Int?
  cost           Float?   // En USD
  
  // Feedback
  wasHelpful     Boolean?
  userFeedback   String?
  
  createdAt      DateTime @default(now())
  
  @@index([conversationId])
  @@index([provider, createdAt])
}

// 6. Audit Log (RGPD)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "CREATE_APPOINTMENT", "UPDATE_KB", "DELETE_RULE"
  entity    String   // "Appointment", "KnowledgeBase", etc.
  entityId  String?
  changes   Json?    // Avant/après
  source    String?  // "web", "whatsapp", "n8n"
  ipAddress String?
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

// 7. N8N Webhooks config
model N8NWebhook {
  id          String   @id @default(cuid())
  name        String   @unique
  webhookUrl  String
  events      String[] // ["appointment.created", "appointment.cancelled"]
  isActive    Boolean  @default(true)
  lastTriggered DateTime?
  totalCalls  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 8. Configuration app
model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([category])
}